# Copy this file to .env (already gitignored — see .gitignore) and fill in
# real values. docker-compose.yml loads .env automatically; nothing in this
# example file is a real secret.

# ---- Compose-level (host ports) ----
SM_SERVER_PORT=8089
FRONTEND_HTTP_PORT=8080

# Backend origin the frontend is built to call. Leave blank to use the
# committed frontend/.env.production value (https://api.configurationmanager.alwaysmoveforward.com).
VITE_API_BASE_URL=

# ---- Database (an existing MySQL instance — see database/README.md) ----
DB_HOST=
DB_PORT=3306
DB_NAME=configurationmanager
DB_USE_SSL=false
SM_DB_USERNAME=
SM_DB_PASSWORD=

# ---- Spring profile ----
SPRING_PROFILES_ACTIVE=production

# ---- Frontend redirect target after login ----
SM_FRONTEND_BASE_URL=https://configurationmanager.alwaysmoveforward.com

# Comma-separated list of origins allowed to call the API with credentials
# (browser CORS). Must include every origin the frontend is actually served
# from — the API rejects requests from anything not on this list.
SM_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://local.configurationmanager.alwaysmoveforward.com:5173,http://local.configurationmanager.alwaysmoveforward.com:5174

# ---- Auth0 (from your Auth0 application settings) ----
SM_AUTH0_DOMAIN=alwaysmoveforward.auth0.com
SM_AUTH0_CLIENT_ID=
SM_AUTH0_CLIENT_SECRET=
# Must exactly match an "Allowed Callback URL" configured in Auth0.
SM_AUTH0_CALLBACK_URL=https://api.configurationmanager.alwaysmoveforward.com/api/auth/callback
SM_AUTH0_AUDIENCE=
SM_LOGOUT_URL=https://configurationmanager.alwaysmoveforward.com

# ---- JWT session cookie ----
# Base64-encoded, >=256-bit key. Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=
JWT_EXPIRATION_MINUTES=480
JWT_COOKIE_NAME=ConfigurationManagerAuth
JWT_COOKIE_SECURE=true
JWT_COOKIE_DOMAIN=configurationmanager.alwaysmoveforward.com

# ---- Secret value encryption ----
# Base64-encoded 256-bit AES key. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_VERSION=1
