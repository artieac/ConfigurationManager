# The backend API origin is normally set per Vite mode, not here — see
# .env.development (dev server) and .env.production (`npm run build`).
#
# Copy this file to .env.local (gitignored) only if you need to override that
# for your own machine — e.g. to point at a backend running on localhost
# instead of the shared dev environment.
VITE_API_BASE_URL=http://local.api.configurationmanager.alwaysmoveforward.com:8081
